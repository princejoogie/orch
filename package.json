{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "orch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "orch": "./src/index.ts"
  },
  "scripts": {
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run package:smoke",
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run scripts/build.ts",
    "build:debug": "bun run scripts/build.ts --sourcemap",
    "build:standalone": "bun run scripts/build-standalone.ts",
    "bench:opencode": "bun run scripts/bench-opencode.ts",
    "changeset": "npm exec --package @changesets/cli@2.31.0 -- changeset",
    "changeset:status": "npm exec --package @changesets/cli@2.31.0 -- changeset status",
    "changeset:version": "npm exec --package @changesets/cli@2.31.0 -- changeset version",
    "test": "bun test test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --tsconfig tsconfig.json src/ scripts/ test/",
    "lint:fix": "oxlint --fix --tsconfig tsconfig.json src/ scripts/ test/",
    "format": "oxfmt --write src/ scripts/ test/",
    "format:check": "oxfmt --check src/ scripts/ test/",
    "package:smoke": "bun run scripts/package-smoke.ts"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.15.11",
    "@opentui/core": "0.2.15",
    "@opentui/react": "0.2.15",
    "@tanstack/react-query": "^5.100.14",
    "react": "19.2.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "oxfmt": "0.41.0",
    "oxlint": "1.60.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
