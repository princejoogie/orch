{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "orch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "orch": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run scripts/build.ts",
    "build:debug": "bun run scripts/build.ts --sourcemap",
    "bench:opencode": "bun run scripts/bench-opencode.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.15.11",
    "@opentui/core": "0.2.15",
    "@opentui/react": "0.2.15",
    "@tanstack/react-query": "^5.100.14",
    "react": "19.2.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "oxfmt": "0.41.0",
    "oxlint": "1.60.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
